{
  "expo": {
    "name": "LoadQ",
    "slug": "loadq",
    "version": "1.2.6",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "loadq",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F0A00"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ca.loadq.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "location"
        ],
        "NSPhotoLibraryUsageDescription": "LoadQ needs access to your photos so you can set your profile picture (used to identify you to drivers and passengers in the queue) and upload a verification photo of your vehicle for driver approval.",
        "NSPhotoLibraryAddUsageDescription": "LoadQ may save trip-related images you take to your photo library.",
        "NSCameraUsageDescription": "LoadQ uses the camera so you can take a profile picture or photograph your vehicle for driver verification."
      },
      "entitlements": {
        "aps-environment": "production"
      },
      "buildNumber": "11"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0F0A00"
      },
      "package": "ca.loadq.app",
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyA2x_gB7pqn5_YSjY6frY30GrNXPUEJORg"
        }
      },
      "versionCode": 41,
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "LoadQ shares your location while you're loading or delivering a parcel so passengers and dispatch can see your position and ETA \u2014 even when the app is in the background.",
          "locationWhenInUsePermission": "LoadQ needs your location to detect when you enter a loading zone.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#2ECC8F"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "platforms": [
      "ios",
      "android"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b060bf16-2660-4856-a05c-0f9e8494c40a"
      }
    }
  }
}